.git
.gitignore
__pycache__
*.pyc
*.pyo
*.pyd
.Python
.env
.venv
venv
build
dist
*.egg-info
.pytest_cache
.mypy_cache
.DS_Store
app/uploads/*
!app/uploads/.gitkeep
.pytest_tmp
instance/*
!instance/.gitkeep
backups/*
generated/*
*.key
*.crt

# Release/audit artifacts are shipped in the source package but must not be copied
# into the runtime image. Apart from reducing image size, this prevents scanners
# from treating historical CycloneDX files as installed runtime dependencies.
SBOM_*.cdx.json
sbom/
SECURITY_AUDIT_*.md
SECURITY_UPDATE_*.md
RC_*_TEST_HARNESS_FIX.md
RELEASE_CANDIDATE_*.md
RELEASE_NOTES_*.md
MIGRATION_*.md
tests/
.pytest_cache/
pytest.ini
requirements-dev.txt

SECURITY_DISPOSITION_*.md
TRIVY_RISK_ACCEPTANCE_*.json

# Editable training sources and visual working files belong to the source release.
# Visual decks are verified in CI and distributed through GitHub Releases, not the Docker image.
docs/presentation/*
docs/CIR_UI_Screenshots.pdf
!docs/presentation/manual-first-page-*.png
charts/
openshift/

# Approved design references remain in the source package. Runtime photography
# and UI assets are the separately packaged files in app/static/ui/.
docs/design/
docs/visual-assets/

# CI-only browser capture and fixture seeding never enter the runtime image.
# Keep validated manuals and app/static/help/ui-runtime evidence installed by CI.
requirements-ui.txt
requirements-docs.txt
scripts/seed_ui_documentation.py
scripts/capture_ui_screenshots.py
scripts/build_training_presentation.py
